"Changed and deleted files are kept" = "Čuvaju se izmijenjene i obrisane datoteke";
"No archived versions yet" = "Još nema arhiviranih verzija";
"When you change or delete a file, the previous copy is kept here for %lld days." = "Kad izmijeniš ili obrišeš datoteku, prethodna kopija čuva se ovdje %lld dana.";
"Drop to upload into %@" = "Pusti za upload u %@";
"Can't show this folder" = "Nije moguće prikazati ovaj folder";
"Try Again" = "Pokušaj ponovno";
"Enter the address and login of your SFTP server." = "Unesi adresu i korisničko ime svog SFTP servera.";
"Enter your account password once. A dedicated key is created on this Mac and added to the server. The password is not stored." = "Jednom unesi lozinku računa. Na ovom Macu napravit će se zaseban ključ i dodati na server. Lozinka se ne sprema.";

/* Language */
"Language" = "Jezik";
"The new language is used after the app restarts." = "Novi jezik koristi se nakon ponovnog pokretanja aplikacije.";
"Restart Now" = "Ponovno pokreni";

/* Provider-neutral setup */
"Back up a folder of your Mac to an SFTP storage server – automatically, with previous versions kept safely." = "Automatski sigurnosno kopiraj mapu s Maca na SFTP poslužitelj, uz sigurno čuvanje prethodnih verzija.";
"The server must accept this key for unattended backups, and the key must have no passphrase." = "Poslužitelj mora prihvaćati ovaj ključ za automatske sigurnosne kopije, a ključ ne smije imati lozinku.";
"Choose a folder on this Mac. It is copied to a folder on the server and kept in sync." = "Odaberi mapu na ovom Macu. Kopira se u mapu na poslužitelju i održava usklađenom.";
"Backup folder on server" = "Mapa sigurnosne kopije na poslužitelju";
"Versions folder on server" = "Mapa verzija na poslužitelju";
"This server folder already contains %lld items." = "Ova mapa na poslužitelju već sadrži %lld stavki.";
"On the first backup, everything in it that isn't in your local folder is moved to the versions folder. The backup folder will then match your Mac exactly." = "Pri prvoj sigurnosnoj kopiji sve što nije u lokalnoj mapi premješta se u mapu verzija. Nakon toga mapa sigurnosne kopije odgovarat će mapi na Macu.";
"Allow remote shell commands for checksums" = "Dopusti naredbe ljuske na poslužitelju za kontrolne zbrojeve";
"Folder paths cannot contain dot or parent-directory segments." = "Putanje mapa ne smiju sadržavati segmente za trenutačnu ili nadređenu mapu.";
"Choose a dedicated backup subfolder on the server. The server root cannot be a backup folder." = "Odaberi zasebnu podmapu za sigurnosnu kopiju na poslužitelju. Korijenska mapa ne može biti mapa sigurnosne kopije.";
"Choose a dedicated versions subfolder on the server." = "Odaberi zasebnu podmapu za verzije na poslužitelju.";
"Download destination already exists: %@" = "Odredište za preuzimanje već postoji: %@";
"Enter your SFTP server connection and choose the folder to back up." = "Unesi podatke SFTP poslužitelja i odaberi mapu za sigurnosnu kopiju.";
"Server storage" = "Prostor na poslužitelju";
"Quota unavailable on this server" = "Podaci o prostoru nisu dostupni na ovom poslužitelju";

/* File history */
"Show previous versions" = "Prikaži prethodne verzije";
"Previous versions" = "Prethodne verzije";
"Refresh version history" = "Osvježi povijest verzija";
"Loading versions…" = "Učitavam verzije…";
"Loading version history…" = "Učitavam povijest verzija…";
"Open a copy" = "Otvori kopiju";
"These are archived backup copies. Your current file is never replaced." = "Ovo su arhivirane sigurnosne kopije. Trenutačna datoteka neće biti zamijenjena.";
"Could not load version history: %@" = "Nije moguće učitati povijest verzija: %@";

/* About */
"About StorageBox Sync…" = "O aplikaciji StorageBox Sync…";
"Version %@" = "Verzija %@";
"Made by PUSH" = "Izradio PUSH";
"Open source under the MIT License. Includes rclone and Sparkle." = "Otvoreni kod pod licencijom MIT. Uključuje rclone i Sparkle.";
"Check for Updates…" = "Provjeri ažuriranja…";
"Changed and deleted files are kept in a versions folder on the server." = "Izmijenjene i obrisane datoteke čuvaju se u mapi verzija na poslužitelju.";
"Files you change or delete on the Mac are moved to the versions folder on the server instead of being overwritten, and kept there for %lld days." = "Datoteke koje izmijeniš ili obrišeš na Macu premještaju se u mapu verzija na poslužitelju umjesto da se prepišu te se ondje čuvaju %lld dana.";
"The backup folder becomes an exact mirror of the local folder. Changed or deleted files move to the versions folder instead of being overwritten." = "Mapa sigurnosne kopije postaje točno zrcalo lokalne mape. Izmijenjene ili obrisane datoteke premještaju se u mapu verzija umjesto da se prepišu.";
"“upload” = a new or changed file goes to the server. “archive” = the old server copy moves to the versions folder." = "„upload” = nova ili izmijenjena datoteka prenosi se na poslužitelj. „archive” = stara kopija s poslužitelja premješta se u mapu verzija.";
"Backups run unattended and need an SSH key. Not listed because they use a password: %@. To switch one to an SSH key, right-click it under Servers and choose Edit…" = "Backup radi bez nadzora i treba SSH ključ. Nisu navedeni jer koriste lozinku: %@. Za prelazak na SSH ključ desnom tipkom klikni server pod Serveri i odaberi Uredi…";
"Names that exist twice on the server with differently encoded letters: %ld (e.g. “%@”). One copy of each is skipped – see the log." = "Imena koja na serveru postoje dvaput s različito kodiranim slovima: %ld (npr. „%@“). Jedna kopija svakog se preskače – vidi zapisnik.";
